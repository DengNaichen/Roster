#!/usr/bin/env sh
# Clean up a branch whose PR was squash-merged: verify the PR record, sync
# main, drop the worktree runtime, remove the worktree and delete the local and
# remote branch. Run from the primary checkout. See
# .agents/skills/git-workflow/SKILL.md.
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname -- "$script_dir")
repo=DengNaichen/Roster

usage() {
	printf '%s\n' "usage: scripts/finish-branch <branch> [--dry-run]" >&2
	exit 2
}

fail() {
	printf 'scripts/finish-branch: %s\n' "$1" >&2
	exit 1
}

step() {
	printf '==> %s\n' "$1"
}

run() {
	if [ "$dry_run" -eq 1 ]; then
		printf '    (dry-run) %s\n' "$*"
	else
		"$@"
	fi
}

branch=""
dry_run=0
while [ "$#" -gt 0 ]; do
	case "$1" in
		--dry-run) dry_run=1; shift ;;
		-*) usage ;;
		*) [ -z "$branch" ] || usage; branch=$1; shift ;;
	esac
done
[ -n "$branch" ] || usage
[ "$branch" != main ] || fail "main is never cleaned up"

primary=$(git -C "$repo_root" worktree list --porcelain | sed -n '1s/^worktree //p')
[ -n "$primary" ] || fail "cannot determine the primary checkout"
# The script must not live in the worktree it is about to remove.
[ "$(cd "$repo_root" && pwd -P)" = "$(cd "$primary" && pwd -P)" ] ||
	fail "run this from the primary checkout: $primary/scripts/finish-branch"

step "Verify the PR record"
pr=$(gh pr list --repo "$repo" --head "$branch" --state merged \
	--json number,headRefOid,mergeCommit \
	--jq 'if length == 1 then "\(.[0].number) \(.[0].headRefOid) \(.[0].mergeCommit.oid)" else "" end') ||
	fail "gh pr list failed"
[ -n "$pr" ] || fail "no single merged PR found for $branch; not cleaning up"
set -- $pr
number=$1
head=$2
merge_commit=$3
printf '    PR #%s merged; head %s, merge commit %s\n' "$number" "$head" "$merge_commit"

local_tip=$(git -C "$primary" rev-parse --verify --quiet "refs/heads/$branch" || true)
if [ -n "$local_tip" ] && [ "$local_tip" != "$head" ]; then
	fail "local $branch is at $local_tip, not the merged head $head; commits after the merge are not in main"
fi
remote_tip=$(git -C "$primary" ls-remote --heads origin "refs/heads/$branch" | cut -f1)
if [ -n "$remote_tip" ] && [ "$remote_tip" != "$head" ]; then
	fail "origin/$branch is at $remote_tip, not the merged head $head; commits after the merge are not in main"
fi

worktree=$(git -C "$primary" worktree list --porcelain | awk -v ref="branch refs/heads/$branch" '
	/^worktree / { path = substr($0, 10) }
	$0 == ref { print path }')
if [ -n "$worktree" ]; then
	[ -z "$(git -C "$worktree" status --porcelain)" ] ||
		fail "worktree $worktree has uncommitted changes; commit, push or discard them first"
fi

step "Sync main in the primary checkout"
[ "$(git -C "$primary" symbolic-ref --quiet --short HEAD || true)" = main ] ||
	fail "primary checkout is not on main"
[ -z "$(git -C "$primary" status --porcelain --untracked-files=no)" ] || fail "primary checkout has uncommitted changes"
git -C "$primary" fetch --prune --no-tags origin +refs/heads/main:refs/remotes/origin/main
run git -C "$primary" merge --ff-only -q origin/main
git -C "$primary" merge-base --is-ancestor "$merge_commit" origin/main ||
	fail "merge commit $merge_commit is not on origin/main"

if [ -n "$worktree" ]; then
	step "Clean the worktree runtime and remove $worktree"
	run sh -c "cd \"\$1\" && node scripts/toolchain.mjs deno task worktree:clean" sh "$worktree"
	run git -C "$primary" worktree remove "$worktree"
else
	step "No worktree checks out $branch"
fi

if [ -n "$local_tip" ]; then
	step "Delete local branch $branch"
	run git -C "$primary" branch -D "$branch"
fi
if [ -n "$remote_tip" ]; then
	step "Delete origin/$branch with lease $head"
	run git -C "$primary" push origin "--force-with-lease=$branch:$head" --delete "$branch"
fi

step "Prune"
run git -C "$primary" fetch --prune --no-tags origin
git -C "$primary" worktree list
