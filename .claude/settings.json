{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && node scripts/toolchain.mjs setup && node scripts/toolchain.mjs deno task worktree:setup --if-needed",
            "timeout": 600
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/toolchain.mjs\" deno run --allow-env --allow-net --allow-read --allow-write --allow-run \"${CLAUDE_PROJECT_DIR}/scripts/worktree-runtime.ts\" cleanup-hook",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
