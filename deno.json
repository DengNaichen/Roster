{
  "compilerOptions": { "strict": true },
  "nodeModulesDir": "none",
  "imports": { "zod": "npm:zod@4.6.7" },
  "tasks": {
    "check": "deno check packages/backend/src/bootstrap.ts packages/backend/src/jobs.ts supabase/functions/api/index.ts supabase/functions/mcp/index.ts supabase/functions/jobs/index.ts supabase/functions/github-webhook/index.ts scripts/preview.ts scripts/worktree-runtime.ts scripts/migrate.ts scripts/import-sqlite.ts scripts/import-linear.ts",
    "test": "deno test --allow-env --allow-net --allow-read packages/backend/src",
    "dev": "deno run --allow-env --allow-net --env-file=.env scripts/dev.ts",
    "worktree:setup": "deno run --allow-env --allow-net --allow-read --allow-write --allow-run scripts/worktree-runtime.ts setup",
    "worktree:clean": "deno run --allow-env --allow-net --allow-read --allow-write --allow-run scripts/worktree-runtime.ts cleanup",
    "worktree:gc": "deno run --allow-env --allow-net --allow-read --allow-write --allow-run scripts/worktree-runtime.ts gc",
    "preview:api": "deno run --allow-env --allow-net --allow-read --allow-write --allow-run scripts/worktree-runtime.ts preview api",
    "preview:web": "deno run --allow-env --allow-net --allow-read --allow-write --allow-run scripts/worktree-runtime.ts preview web"
  },
  "fmt": { "singleQuote": true, "lineWidth": 100 },
  "exclude": ["apps/web", "node_modules"]
}
