# Backend only. Use a dedicated database login granted the roster_app role.
DATABASE_URL=postgresql://roster_runtime:CHANGE_ME@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MCP_PUBLIC_URL=http://127.0.0.1:18471
AUTH_AUDIENCE=authenticated
PORT=18471
# Optional server-managed GitHub App integration. One repository maps to one workspace.
# Binding example: [{"workspace":"roster","repo":"owner/repo","installationId":123,"repositoryId":456,"completion":"manual"}]
GITHUB_BINDINGS=[]
GITHUB_APP_ID=
# PEM private key supplied via server secrets; never expose it in VITE_* variables.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
JOBS_TOKEN=
