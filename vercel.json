{
  "framework": "vite",
  "installCommand": "node scripts/toolchain.mjs setup",
  "buildCommand": "node scripts/toolchain.mjs build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://jmmwgdyfcmonzqkurcly.supabase.co/functions/v1/mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/oauth/:action(authorize|token|register)",
      "destination": "https://jmmwgdyfcmonzqkurcly.supabase.co/functions/v1/mcp/oauth/:action"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
