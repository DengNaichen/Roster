VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=YOUR_LOCAL_PUBLISHABLE_OR_ANON_KEY
VITE_API_BASE_URL=http://127.0.0.1:18471
# Hosted Edge routing defaults to Roster's measured database region, eu-west-3.
# Set to any for automatic selection/failover. Deploy backend CORS support before frontend.
VITE_API_REGION=eu-west-3
# Development only, and only when accessed via loopback hostname.
# Uses the isolated preview backend at http://127.0.0.1:18471.
VITE_LOCAL_PREVIEW=false
